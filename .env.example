# Required for the configured AUG14 account.
# Replace placeholders locally. Never commit your real .env file.
# Safe default: live public market data, simulated order state, no account orders.
DRY_RUN=true

# Reserved for a future live integration. Live mode is currently hard-disabled.
PRIVATE_KEY_AUG14=0xYOUR_PRIVATE_KEY
PUBLIC_KEY_AUG14=0xYOUR_POLYMARKET_WALLET_ADDRESS
# AUG14 is expected to use a Safe/proxy wallet (2). Verify this against the funded wallet.
SIGNATURE_TYPE=2

# Optional: if omitted, the bot asks the CLOB client to derive API credentials.
API_KEY_AUG14=
API_SECRET_AUG14=
PASSPHRASE_AUG14=

# Strategy configuration (used by 5min_95_bid_sniper.py).
# Adjust these to test different thresholds / sizing without editing code.
TARGET_NOTIONAL_USD=1.0
MAX_ORDER_NOTIONAL_USD=5.0
ENTRY_THRESHOLD=0.95
MAX_BUY_PRICE=0.95
MAX_TOTAL_EXPOSURE_USD=5.0
MAX_SESSION_LOSS_USD=8
MAX_POSITION_LOSS_USD=4.50
MIN_DECIDED_BID=0.88
MAX_OPPOSITE_BID=0.08
EARLY_WINDOW_MAX_BUY_PRICE=0.93
ENTRY_WINDOW_SEC=60
SOFT_ENTRY_CUTOFF_SEC=15
STOP_THRESHOLD_SEC=10
ORDER_UPDATE_INTERVAL=1
PRICE_HOLD_TOLERANCE=0.005
